{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/algebra.html",
      "destination": "/study-hall/algebra.html"
    },
    {
      "source": "/archive.html",
      "destination": "/study-hall/archive.html"
    },
    {
      "source": "/biology.html",
      "destination": "/study-hall/biology.html"
    },
    {
      "source": "/calendar.html",
      "destination": "/study-hall/calendar.html"
    },
    {
      "source": "/chemistry.html",
      "destination": "/study-hall/chemistry.html"
    },
    {
      "source": "/english.html",
      "destination": "/study-hall/english.html"
    },
    {
      "source": "/handbook.html",
      "destination": "/study-hall/handbook.html"
    },
    {
      "source": "/history.html",
      "destination": "/study-hall/history.html"
    },
    {
      "source": "/notes.html",
      "destination": "/study-hall/notes.html"
    },
    {
      "source": "/planner.html",
      "destination": "/study-hall/planner.html"
    },
    {
      "source": "/practice.html",
      "destination": "/study-hall/practice.html"
    },
    {
      "source": "/reading.html",
      "destination": "/study-hall/reading.html"
    },
    {
      "source": "/resources.html",
      "destination": "/study-hall/resources.html"
    },
    {
      "source": "/review.html",
      "destination": "/study-hall/review.html"
    }
  ]
}
